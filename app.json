{
  "expo": {
    "name": "Welyt",
    "slug": "Welyt-mobile",
    "version": "0.1.0",
    "scheme": "welyt",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.tapanmeena.welyt",
      "supportsTablet": true
    },
    "android": {
      "package": "com.tapanmeena.welyt",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#26333c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#26333c"
        }
      ],
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Welyt to use Face ID to unlock the app."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Welyt to use Face ID to unlock the app."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "mode": "development",
          "enableRemoteNotifications": true,
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "38ca27d6-eb6f-4d3f-8f9f-c3bb59e370dc"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/38ca27d6-eb6f-4d3f-8f9f-c3bb59e370dc"
    }
  }
}
