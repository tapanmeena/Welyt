NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Comma-separated trusted proxy IPs/CIDRs. Leave empty for direct local development.
TRUST_PROXY=
DATABASE_URL=./data/welyt.db
AUTHKIT_ISSUER_URL=https://auth.tapanmeena.com
AUTHKIT_POOL_SLUG=one-auth
APP_SCHEME=welyt-dev
CORS_ORIGINS=*
FX_AUTO_REFRESH=true
# Interactive Swagger UI at /docs (defaults to true in development, false otherwise)
API_DOCS_ENABLED=true

