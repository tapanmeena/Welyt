NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=./data/welyt.db
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
APP_SCHEME=welyt
CORS_ORIGINS=*

# Gmail SMTP (automatically enabled when SMTP_USER and SMTP_PASS are filled in; falls back to console logs when empty)
MAILER_PROVIDER=auto
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

