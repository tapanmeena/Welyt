{
  "name": "welyt",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "mobile": "npm --workspace=welyt-mobile run start",
    "mobile:web": "npm --workspace=welyt-mobile run web",
    "mobile:android": "npm --workspace=welyt-mobile run android",
    "mobile:ios": "npm --workspace=welyt-mobile run ios",
    "mobile:prebuild": "npm --workspace=welyt-mobile run prebuild",
    "mobile:export:check": "npm --workspace=welyt-mobile run export:check",
    "api": "npm --workspace=welyt-api run dev",
    "api:build": "npm --workspace=welyt-api run build",
    "api:start": "npm --workspace=welyt-api run start",
    "typecheck": "npm --workspaces run typecheck",
    "lint": "npm --workspaces run lint",
    "lint:fix": "npm --workspaces run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:dependencies": "npm --workspace=welyt-mobile run check:dependencies",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run check:dependencies"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "typescript": "~6.0.3"
  }
}
