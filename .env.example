# Docker Compose deployment only. Local API development uses apps/api/.env.
# Generate a persistent secret with: openssl rand -hex 32
JWT_ACCESS_SECRET=

# Authentication token expiry and email verification limits.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Match the installed app: welyt, welyt-preview, or welyt-dev.
APP_SCHEME=welyt
# Leave empty for native-only use; otherwise list exact browser frontend origins.
CORS_ORIGINS=
FX_AUTO_REFRESH=true
API_DOCS_ENABLED=false

# SMTP is required by the production Compose configuration.
# Single-quote values containing $ to prevent Compose interpolation.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Optional implicit TLS override. Unset selects true on port 465, false otherwise.
# SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
