# Docker Compose deployment only. Local API development uses apps/api/.env.
# Generate a persistent secret with: openssl rand -hex 32
JWT_ACCESS_SECRET=

# Match the installed app: welyt, welyt-preview, or welyt-dev.
APP_SCHEME=welyt
# Leave empty for native-only use; otherwise list exact browser frontend origins.
CORS_ORIGINS=
FX_AUTO_REFRESH=true

# SMTP is required by the production Compose configuration.
# Single-quote values containing $ to prevent Compose interpolation.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
